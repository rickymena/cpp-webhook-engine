# Build output
build/
build-*/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
compile_commands.json

# Runtime artifacts - saved webhook payloads can contain tokens and PII
logs/
*.log

# Local-only notes and docs (not meant to be committed)
documentation/
docs/

# Fuzzing corpus - regenerate with the merge command in the README.
# Local-only: it is derived data, and inputs are attacker-shaped byte
# blobs we would rather not carry in history.
corpus/
crash-*
leak-*
timeout-*
oom-*

# Object files, libraries, binaries
*.o
*.obj
*.so
*.a
*.out
webhook_server
core
core.*

# Editor / OS cruft
.vscode/
.idea/
*.swp
.DS_Store
